<infinispan xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="urn:infinispan:config:16.0 https://infinispan.org/schemas/infinispan-config-16.0.xsd
                          urn:infinispan:server:16.0 https://infinispan.org/schemas/infinispan-server-16.0.xsd"
      xmlns="urn:infinispan:config:16.0"
      xmlns:server="urn:infinispan:server:16.0">

   <cache-container name="default" statistics="true">
      <!-- Mutual TLS only: the endpoint requires a client certificate at the TLS
           layer (require-ssl-client-auth), but there is NO SASL authentication and
           no cache-container <authorization> (RBAC). This isolates the client's
           mutual-TLS cert presentation (issue #18) from SASL. -->

      <transport cluster="${infinispan.cluster.name:cluster}" stack="${infinispan.cluster.stack:tcp}"/>

      <distributed-cache-configuration name="org.infinispan.DIST_SYNC" mode="SYNC">
         <encoding media-type="application/octet-stream"/>
      </distributed-cache-configuration>

      <!-- Pre-defined cache the mutual-TLS integration test targets. -->
      <distributed-cache name="mtlscache" mode="SYNC">
         <encoding media-type="application/octet-stream"/>
      </distributed-cache>
   </cache-container>

   <server xmlns="urn:infinispan:server:16.0">
      <interfaces>
         <interface name="public">
            <inet-address value="${infinispan.bind.address:0.0.0.0}"/>
         </interface>
      </interfaces>

      <socket-bindings default-interface="public" port-offset="${infinispan.socket.binding.port-offset:0}">
         <socket-binding name="default" port="${infinispan.bind.port:11222}"/>
      </socket-bindings>

      <security>
         <security-realms>
            <!-- TLS realm providing a server identity (PKCS12 keystore, alias
                 "server", SAN DNS:localhost / IP:127.0.0.1) PLUS a truststore that
                 trusts the client CA. With require-ssl-client-auth on the endpoint,
                 the server verifies every client certificate against this
                 truststore. The truststore is a PEM bundle (client-truststore.pem:
                 the client leaf cert + its CA); the server auto-detects PEM, so
                 password="" per the schema. Both files are mounted into the conf dir
                 by start_infinispan_mtls.sh. -->
            <security-realm name="tls">
               <server-identities>
                  <ssl>
                     <keystore path="server.p12"
                               relative-to="infinispan.server.config.path"
                               password="password"
                               alias="server"
                               type="PKCS12"/>
                     <truststore path="client-truststore.pem"
                                 relative-to="infinispan.server.config.path"
                                 password=""/>
                  </ssl>
               </server-identities>
            </security-realm>
         </security-realms>
      </security>

      <endpoints>
         <endpoint socket-binding="default" security-realm="tls" require-ssl-client-auth="true">
            <!-- No <authentication>: mutual TLS at the transport, no SASL. -->
            <hotrod-connector/>
            <!-- Single-port endpoint requires a REST route even though these
                 tests only exercise Hot Rod over mutual TLS. -->
            <rest-connector/>
         </endpoint>
      </endpoints>
   </server>
</infinispan>
